<body>
    <svg width="0" height="0"><clipPath id="heart-mask"><path d="M90 160C35 110 0 70 0 45C0 20 20 0 45 0C60 0 75 5 85 20C95 5 110 0 125 0C150 0 170 20 170 45C170 70 135 110 80 160Z"/></clipPath></svg>

    <div id="main-container">
        <h1>Ti amo tanto ele!!</h1>
        <div id="img-cont"><img src="hellokitty.jpg" alt="Hello Kitty"></div>
        <button onclick="openMsg()">Cliccami tesoro</button>
    </div>

    <div id="message-box">
        <p id="dedica">Ti amo tantissimo, sei unica per me... ma probabilmente questo l'hai già capito dalla lettera!</p>
        <button onclick="closeMsg()">Chiudi</button>
        <!-- Aggiunto evento su mouse e su tocco -->
        <button id="btn-scappa" onmouseenter="moveBtn()" ontouchstart="moveBtn()">Ti amo di più</button>
    </div>

    <script>
        function openMsg() {
            document.getElementById('message-box').style.display = 'flex';
            for(let i=0; i<30; i++) createExplosionHeart();
        }

        function closeMsg() { document.getElementById('message-box').style.display = 'none'; }

        function moveBtn() {
            const b = document.getElementById('btn-scappa');
            // Impostiamo la posizione fissa in modo che possa saltare ovunque sullo schermo
            b.style.position = 'fixed';
            b.style.left = Math.random() * 60 + 20 + 'vw';
            b.style.top = Math.random() * 60 + 20 + 'vh';
        }

        function createExplosionHeart() {
            const h = document.createElement('div');
            h.innerHTML = '❤️'; h.className = 'falling-heart';
            h.style.left = '50vw'; h.style.top = '50vh';
            document.body.appendChild(h);
            const angle = Math.random() * Math.PI * 2;
            const velocity = Math.random() * 10 + 5;
            let x = 0, y = 0;
            const animate = () => {
                x += Math.cos(angle) * velocity;
                y += Math.sin(angle) * velocity;
                h.style.transform = `translate(${x}px, ${y}px)`;
                if(Math.abs(x) < 500 && Math.abs(y) < 500) requestAnimationFrame(animate);
                else h.remove();
            };
            animate();
        }
    </script>
</body>
</html>
