    <meta charset="UTF-8">
    <title>Per la mia Ele ❤️</title>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%); font-family: 'Arial', sans-serif; overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        #main-container { text-align: center; background: rgba(255, 255, 255, 0.4); padding: 40px; border-radius: 30px; backdrop-filter: blur(10px); z-index: 10; }
        h1 { color: white; font-size: 2.5rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.2); }
        #img-cont { width: 180px; height: 180px; clip-path: url("#heart-mask"); background: white; margin: 20px auto; }
        #img-cont img { width: 100%; height: 100%; object-fit: cover; }
        button { padding: 15px 30px; font-size: 1.2rem; background: #ff4d6d; color: white; border: none; border-radius: 50px; cursor: pointer; margin: 10px; transition: 0.2s; }
        #message-box { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); color: white; justify-content: center; align-items: center; z-index: 100; flex-direction: column; padding: 20px; text-align: center; }
        .falling-heart { position: absolute; font-size: 20px; z-index: 1; pointer-events: none; }
        #dedica { font-size: 1.8rem; margin-bottom: 20px; max-width: 80%; }
        #btn-scappa { position: relative; }
    </style>
